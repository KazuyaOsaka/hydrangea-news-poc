# Gemini API
GEMINI_API_KEY=AIza...

# ── 階層型モデルフォールバック (TIER1 → TIER4 の順に試行) ──────────────────────
# F-gemini-quality-tier-poc 最終布陣 v2 (2026-05-27)。役割別に異なる Tier 階層を使う:
#   - QUALITY 系統 (judge, script, analysis): GEMINI_MODEL_TIER1〜4 (gemini-3.5-flash 主軸)
#     ★ editorial_mission_filter は judge client 共用のため QUALITY (3.5-flash) で稼働
#   - ARTICLE 系統 (article): GEMINI_ARTICLE_TIER1〜4 (gemini-2.5-flash 主軸、output コスト最適化)
#   - LIGHTWEIGHT 系統 (garbage_filter, merge_batch): GEMINI_LIGHTWEIGHT_TIER1〜4 (gemini-3.1-flash-lite 主軸)
# 429/503 エラー時: 各 Tier を MAX_ATTEMPTS 回リトライ後に次 Tier へ切替

# ── 性能タスク (judge, script, analysis) 用 Tier 階層 — Narrative 品質主軸 ──
GEMINI_MODEL_TIER1=gemini-3.5-flash                  # 最高性能 Stable (Narrative 本命)
GEMINI_MODEL_TIER2=gemini-2.5-flash                  # 安定 GA fallback
GEMINI_MODEL_TIER3=gemini-3.1-flash-lite             # 高速 GA
GEMINI_MODEL_TIER4=gemini-2.5-flash-lite             # 最軽量 GA (最終安全網)

# ── ARTICLE タスク (article) 用 Tier 階層 — output コスト最適化 (output $9.00→$2.50) ──
GEMINI_ARTICLE_TIER1=gemini-2.5-flash                # GA, output 単価最安級 (article 主軸)
GEMINI_ARTICLE_TIER2=gemini-3.5-flash                # 高性能 fallback
GEMINI_ARTICLE_TIER3=gemini-3.1-flash-lite           # 高速 GA
GEMINI_ARTICLE_TIER4=gemini-2.5-flash-lite           # 最軽量 GA (最終安全網)

# ── 軽量タスク (garbage_filter, merge_batch) 用 Tier 階層 — 低コスト・高 RPD 主軸 ──
GEMINI_LIGHTWEIGHT_TIER1=gemini-3.1-flash-lite          # GA, 低コスト・高 RPD (主軸)
GEMINI_LIGHTWEIGHT_TIER2=gemini-2.5-flash-lite          # GA, 最軽量
GEMINI_LIGHTWEIGHT_TIER3=gemini-2.5-flash               # GA, 緊急 fallback (高性能)
GEMINI_LIGHTWEIGHT_TIER4=gemini-2.5-flash-lite          # GA, 最終安全網

# ── Tier ごとの MAX_ATTEMPTS (最終布陣 v2) ──
# QUALITY = 2 (品質 role は retry を厚く)、LIGHTWEIGHT / ARTICLE = 1 (大量・コスト最適 role)
GEMINI_QUALITY_MAX_ATTEMPTS=2
GEMINI_LIGHTWEIGHT_MAX_ATTEMPTS=1
GEMINI_ARTICLE_MAX_ATTEMPTS=1

# ── Judge primary モデル (最終布陣 v2: judge Tier1 = gemini-3.5-flash) ──
# ★ get_judge_llm_client() は models.list で解決した JUDGE_MODEL を primary に置き、
#   QUALITY Tier 階層 (3.5-flash→2.5-flash→3.1-flash-lite→2.5-flash-lite) を後続に連結する。
#   未指定だと JUDGE_MODEL は GEMINI_MODEL_TIER2 (=gemini-2.5-flash) を既定に取り judge primary が
#   2.5-flash に落ちるため、lineup v2 の judge=3.5-flash を実現するよう明示設定する。
#   editorial_mission_filter / elite_judge も本 client を共用 (= 3.5-flash)。
JUDGE_MODEL=gemini-3.5-flash

# ── Gemini API 呼び出し間隔 (秒) — 各 Tier の RPM 上限を尊重 ────────────────────
# 安全マージン 70% 想定。
# TIER1 (gemini-3-flash-preview, RPM=15): ~5.7s
# TIER2 (gemini-2.5-flash-lite,         RPM=10): ~8.6s
# TIER3 (gemini-3-flash-preview,         RPM=5): ~17.2s
# TIER4 (gemini-2.5-flash,               RPM=5): ~17.2s
GEMINI_CALL_INTERVAL_SEC_TIER1=5.7
GEMINI_CALL_INTERVAL_SEC_TIER2=8.6
GEMINI_CALL_INTERVAL_SEC_TIER3=17.2
GEMINI_CALL_INTERVAL_SEC_TIER4=17.2

# Paths (デフォルト値で動くので変更不要)
INPUT_DIR=data/input
OUTPUT_DIR=data/output
DB_PATH=data/db/hydrangea.db

# Logging
LOG_LEVEL=INFO

# ── 運用スケジュール ──────────────────────────────────────────────────────────
# 1日の実行回数 (スケジューラ設定の目安)
RUNS_PER_DAY=5

# ── F-16-A: per-run 上限 (cron 自動実行 × per-run 上限で公開頻度を制御) ──
# 真の本番運用 (F-16-B 実装後): cron 6 時間おき × 4 run/日
#   - 動画化対象 = 4 run × TOP_N_VIDEOS_PER_RUN   (default 1) = 4 動画/日
#   - 記事化対象 = 4 run × TOP_N_ARTICLES_PER_RUN (default 3) = 12 記事/日
# 設計上 video ⊆ article。video > article は無効でクランプされる。
TOP_N_VIDEOS_PER_RUN=1     # 1 run あたりの動画 (script + video) 生成数
TOP_N_ARTICLES_PER_RUN=3   # 1 run あたりの記事 (article) 生成数

# DEPRECATED (F-16-A で廃止予定): 1 日の最大公開件数。
# per-day 単一上限では Top-3 候補が 5 件上限で skip される事故 (試運転 7-I) が
# 発生したため撤廃。後方互換のため env / コードからは読み続けるが、
# default 999 で実質無効化。新環境では TOP_N_VIDEOS_PER_RUN /
# TOP_N_ARTICLES_PER_RUN を使うこと。
# MAX_PUBLISHES_PER_DAY=999

# ── LLM 呼び出し予算 ──────────────────────────────────────────────────────────
# 1回の実行あたりの上限 (cluster_merge + script + article で最大 ~12)
LLM_CALL_BUDGET_PER_RUN=12
# 1日あたりの上限 (5回 × 12 = 60 消費想定、余裕を持って 120)
LLM_CALL_BUDGET_PER_DAY=120
# normalized モード: JP クラスタ 1 件あたり比較する EN 候補数 (小さくするほど LLM 節約)
EN_CANDIDATES_PER_JP_CLUSTER=2

# ── 分析レイヤー（Phase 1: geo_lens 単独稼働） ────────────────────────────────
# false = 既存パイプラインのみ動作（旧 default、target_enemy 含む旧ルート稼働）
# true  = Recency Guard + 観点抽出 + LLM 多角的分析 + 洞察抽出 + 尺プロファイル選定
#         + particular_angle_metadata + sontaku_signals 抽出 + 新ルート起動
# ★ X1 (F-particular-angle-metadata-production-wire / 2026-05-31): true に倒し、
#   新ルートを正式 production default とする (target_enemy 退役 +
#   particular_angle_metadata + sontaku_signals 起動)。
ANALYSIS_LAYER_ENABLED=true
# 分析レイヤーで使うチャンネル ID（configs/channels.yaml に定義された channel_id）
DEFAULT_CHANNEL_ID=geo_lens
# 分析レイヤーの LLM クライアント設定（事実重視）
# ★ X1 で MAX_TOKENS 2000 → 4096 に拡張 (F-analysis-max-tokens-tune 統合、
#   particular_angle_extractor + perspective/insight 抽出での JSON 途中切断回避)。
# ★ analysis primary tier = gemini-3.5-flash (Gemini 3 系) のため、factory.py の
#   temperature ガードで temperature は generation_config に含めない (default 1.0)。
#   ANALYSIS_LLM_TEMPERATURE は Gemini 2 系 fallback 時のみ反映。
ANALYSIS_LLM_TEMPERATURE=0.3
ANALYSIS_LLM_MAX_TOKENS=4096
# 1 run あたり分析レイヤーで消費しうる LLM 呼び出しの目安（観測用）
ANALYSIS_MAX_LLM_CALLS_PER_RUN=10
# Recency Guard: 直近 N 時間内の同一 entity/topic を降格する窓
RECENCY_GUARD_HOURS=24
# Recency Guard: 重複ヒット時のスコア倍率（0.5 = 半減）
RECENCY_GUARD_PENALTY=0.5
# DEPRECATED (F-16-A で TOP_N_ARTICLES_PER_RUN にリネーム):
# Top-N 台本生成: 分析レイヤー設計では 1 本フォーカス推奨。env 未指定時は 3（既存挙動）。
# F-4: AnalysisLayer を Top-N 全 Slot で実行する際の N 値も同じ env を再利用する。
# F-16-A: TOP_N_ARTICLES_PER_RUN が設定されていない場合の fallback default として
# 引き続き読まれる。新環境では TOP_N_ARTICLES_PER_RUN を使うこと。
# TOP_N_GENERATION=3

# ── Editorial Mission Filter（Hydrangea 編集ミッション適合度ゲート） ─────────
# 7軸 (perspective_gap / geopolitical_significance / blindspot_severity /
# political_intent / hidden_power_dynamics / economic_interests /
# discussion_potential) で「日本人に届けるべきニュース」を選別する。
# false で完全スキップ、スコアはセットされない。
EDITORIAL_MISSION_FILTER_ENABLED=true
# Step-1 prescore (静的ルール) から Step-2 LLM scoring に送る上位候補数
MISSION_PRESCORE_TOP_N=20
# Step-2 LLM scoring を実行するか（false にすると prescore のみ）
MISSION_LLM_ENABLED=true
# editorial_mission_score < この値の候補は生成前にドロップ（暫定値; 運用データで調整予定）
MISSION_SCORE_THRESHOLD=45.0

# ── F-13.B: 日本の大手メディアでの報道有無を Web 検証 ────────────────────────
# JP ソース 0 件の候補に対して Gemini Grounding (Google Search) で
# 日本の大手メディアの報道有無を確認する。
# 大手メディア報道あり → Hydrangea 取り込み漏れケースとして divergence 生成
# 大手メディア報道なし → 真の blind_spot_global として動画化 (ミッション本丸)
# 検証対象: 全国紙、通信社、大手テレビ局、主要ビジネスメディア (27 ドメイン)
# 除外: Yahoo!ニュース、個人ブログ、SNS、タブロイド誌等
# rescue path (judge_report.json / followup_queries.*) は完全廃止。
JP_COVERAGE_VERIFIER_ENABLED=true
# 同一 event_id への重複検証を抑制するキャッシュ有効時間 (時間)
JP_COVERAGE_CACHE_HOURS=24
# Grounding に使うモデル名 (デフォルトで Google Search 連携可能なモデル)
JP_COVERAGE_GROUNDING_MODEL=gemini-2.5-flash
